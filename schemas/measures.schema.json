{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moi-electeur.fr/schemas/measures.schema.json",
  "title": "MeasuresFile",
  "type": "object",
  "additionalProperties": false,
  "required": ["election_id", "measures"],
  "properties": {
    "election_id": {
      "type": "string"
    },
    "measures": {
      "type": "array",
      "items": {
        "title": "Measure",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "candidate_id",
          "theme",
          "title",
          "summary",
          "costing",
          "evidence",
          "review"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^m[0-9]{3}$"
          },
          "candidate_id": {
            "type": "string"
          },
          "theme": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string"
          },
          "costing": {
            "$ref": "#/$defs/costing"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "evidence.schema.json"
            }
          },
          "proposed": {
            "title": "ProposedMeasure",
            "description": "Contenu proposé par l'extraction, conservé quand la revue le corrige (statut corrected seulement).",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "costing": {
                "$ref": "#/$defs/costing"
              }
            }
          },
          "review": {
            "$ref": "review.schema.json"
          }
        }
      }
    }
  },
  "$defs": {
    "costing": {
      "title": "Costing",
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["chiffre", "partiel", "intention"]
        },
        "amount_eur": {
          "type": ["number", "null"]
        },
        "period": {
          "type": ["string", "null"]
        },
        "quote": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
