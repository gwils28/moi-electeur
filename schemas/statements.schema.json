{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moi-electeur.fr/schemas/statements.schema.json",
  "title": "StatementsFile",
  "type": "object",
  "additionalProperties": false,
  "required": ["election_id", "statements"],
  "properties": {
    "election_id": { "type": "string" },
    "statements": {
      "type": "array",
      "minItems": 25,
      "maxItems": 35,
      "items": {
        "title": "Statement",
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "theme", "text", "axis", "direction", "weight_in_axis"],
        "properties": {
          "id": { "type": "string", "pattern": "^s[0-9]{2}$" },
          "theme": { "type": "string" },
          "text": { "type": "string", "minLength": 10 },
          "axis": { "type": "string", "enum": ["x", "y"] },
          "direction": {
            "type": "integer",
            "enum": [-1, 1],
            "description": "+1 si « d'accord » pousse vers +10 sur l'axe."
          },
          "weight_in_axis": { "type": "number", "exclusiveMinimum": 0, "maximum": 3 }
        }
      }
    }
  }
}
