{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moi-electeur.fr/schemas/election_config.schema.json",
  "title": "ElectionConfig",
  "description": "Configuration d'une élection : axes, thèmes (dans l'ordre d'affichage), candidats, corpus officiel.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "country",
    "date_first_round",
    "axes",
    "quadrants",
    "themes",
    "candidates",
    "corpus"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/slug" },
    "name": { "type": "string", "minLength": 1 },
    "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "date_first_round": { "type": "string", "format": "date" },
    "fictional": {
      "type": "boolean",
      "description": "Vrai pour une élection de démonstration aux candidats inventés."
    },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": { "x": { "$ref": "#/$defs/axis" }, "y": { "$ref": "#/$defs/axis" } }
    },
    "quadrants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tl", "tr", "bl", "br"],
      "properties": {
        "tl": { "type": "string" },
        "tr": { "type": "string" },
        "bl": { "type": "string" },
        "br": { "type": "string" }
      }
    },
    "themes": {
      "type": "array",
      "minItems": 1,
      "description": "L'ordre du tableau est l'ordre d'affichage du questionnaire.",
      "items": {
        "title": "Theme",
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "label": { "type": "string", "minLength": 1 },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "Courte description du périmètre du thème, utilisée pour classer les extraits du corpus (PLAN D16)."
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "items": {
        "title": "Candidate",
        "type": "object",
        "additionalProperties": false,
        "description": "Aucune coordonnée (x, y) ici : elles sont calculées, jamais saisies.",
        "required": ["id", "name", "party", "color", "program_url", "blind_alias"],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "name": { "type": "string", "minLength": 1 },
          "party": { "type": "string" },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "photo": { "type": ["string", "null"] },
          "program_url": { "type": "string", "format": "uri" },
          "blind_alias": { "type": "string", "minLength": 1 }
        }
      }
    },
    "corpus": {
      "type": "array",
      "items": {
        "title": "CorpusDocument",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "document_title",
          "type",
          "source_url",
          "local_path",
          "sha256",
          "retrieved_at"
        ],
        "properties": {
          "candidate_id": { "$ref": "#/$defs/slug" },
          "document_title": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["pdf", "html", "markdown"] },
          "source_url": { "type": "string", "format": "uri" },
          "local_path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "retrieved_at": { "type": "string", "format": "date" }
        }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "axis": {
      "title": "Axis",
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "min_label", "max_label"],
      "properties": {
        "label": { "type": "string" },
        "min_label": { "type": "string", "description": "Libellé du pôle -10." },
        "max_label": { "type": "string", "description": "Libellé du pôle +10." }
      }
    }
  }
}
