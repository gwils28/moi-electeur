data: {"type":"citation","block":28,"verified":true,"cited_text":"Poursuivre la construction de 6 premières centrales nucléaires nouvelle génération, la multiplication par 10 de notre puissance solaire et l’implantation de 50 parcs éoliens en mer d’ici 2050, et bâtir une filière française de production des énergies renouvelables.\n\n","chunk_id":"e9a608824a05-0011","candidate_id":"macron","document_title":"Emmanuel Macron avec vous, programme","source_url":"https://web.archive.org/web/20220317215226id_/https://avecvous.fr/wp-content/uploads/2022/03/Emmanuel-Macron-Avec-Vous-24-pages.pdf","page_number":7,"page_end":8}

