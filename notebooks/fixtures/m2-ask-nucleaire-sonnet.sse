data: {"type":"citation","block":19,"verified":true,"cited_text":"Le passage au 100 % d’énergies renouvelables est un défi technique et humain : les études scientifiques montrent que c’est possible d’ici 2050.\n\n","chunk_id":"df249374c324-0011","candidate_id":"melenchon","document_title":"L'Avenir en commun, programme en version abrégée","source_url":"https://web.archive.org/web/20220410183816id_/https://melenchon2022.fr/wp-content/uploads/2022/04/LAvenir-en-commun-le-programme-en-version-abregee.pdf","page_number":14,"page_end":15}

