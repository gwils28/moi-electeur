{
  "permissions": {
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git reset --hard)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-tests.sh", "timeout": 300 }
        ]
      }
    ]
  }
}
